{
  "name": "sandhacks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "gemini:test": "node scripts/gemini-test.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:init": "node scripts/init-db.mjs",
    "test:backend": "node tests/backend/build.mjs && DATA_DIR=.runtime/backend-test/data node .runtime/backend-test/out.mjs",
    "test:e2e": "playwright test --workers=2",
    "check:secrets": "node scripts/check-secrets.mjs",
    "neon": "node scripts/provider.mjs neon",
    "elevenlabs": "node scripts/provider.mjs elevenlabs",
    "vultr": "node scripts/provider.mjs vultr"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.78.0",
    "@fontsource-variable/inter": "5.3.0",
    "@google/genai": "3.3.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neondatabase/serverless": "1.2.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "neon": {
      "@hono/node-server": "2.1.6",
      "diff": "5.2.2"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@elevenlabs/cli": "1.11.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "neon": "9.5.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "protobufjs@7.6.6": true
  }
}
