# Runtime service credentials. Keep real values in the ignored .env.local file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
ELEVENLABS_API_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

